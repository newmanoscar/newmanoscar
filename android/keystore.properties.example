# Vorlage für android/keystore.properties – die echte Datei ist gitignoriert.
# Alternativ zu dieser Datei lassen sich dieselben Werte als Umgebungsvariablen
# setzen (praktisch für CI):
#   SPESEN_KEYSTORE_FILE, SPESEN_KEYSTORE_PASSWORD, SPESEN_KEY_ALIAS, SPESEN_KEY_PASSWORD
#
# storeFile: relativ zum Ordner android/ oder absolut.

storeFile=spesenrechner.keystore
storePassword=
keyAlias=spesenrechner
keyPassword=
